---
import { pill, postMeta, type Post } from '../../lib/blog';
interface Props { post: Post }
const { post } = Astro.props;
const category = post.categories[0];
const colors = pill(category?.color);
---
<a href={post.url} style="display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; border: 1px solid #E4E8EE; background: #FFFFFF"><img alt={post.heroImageAlt || post.title} src={post.heroImage} loading="lazy" style="display: block; width: 100%; height: 200px; object-fit: cover"/><span style="padding: 22px; display: flex; flex-direction: column; gap: 10px; flex: 1">{category && <span style={`align-self: flex-start; padding: 5px 10px; border-radius: 999px; background: ${colors.bg}; font-size: 12px; font-weight: 800; color: ${colors.fg}; text-transform: uppercase`}>{category.title}</span>}<span style="font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; font-size: 21px; line-height: 1.2; color: #16181D">{post.title}</span>{post.description && <span style="font-size: 15px; line-height: 1.6; color: #5B6575">{post.description}</span>}<span style="margin-top: auto; padding-top: 6px; font-size: 13px; color: #7A8494">{postMeta(post)}</span></span></a>
