---
// Renders a designed page (a template in src/fragments/demo-pages/ filled from Tina content)
// and wires the Tina visual editor preview.
import Header from './Header.astro';
import Footer from './Footer.astro';
import Base from '../layouts/Base.astro';
import config from '../content/global/config.json';
import navigation from '../content/global/navigation.json';
import scriptsSource from '../fragments/scripts.html?raw';
import { renderDemo, globalsFrom, fillTokens, type DemoPage } from '../lib/demo-pages';

const templates = import.meta.glob<string>('../fragments/demo-pages/*.html', { eager: true, query: '?raw', import: 'default' });
const { entry } = Astro.props;
const page = entry.data as DemoPage;
const template = templates[`../fragments/demo-pages/${page.demoTemplate}.html`];
if (!template) throw new Error(`Missing design ${page.demoTemplate} for ${entry.id}`);
const collection = entry.collection;
const relativePath = entry.filePath.replace(`src/content/${collection}/`, '');
const globals = globalsFrom(config);
const preview = JSON.stringify({ template, collection, relativePath, page, globals }).replace(/</g, '\\u003c');
---
<Base title={String(fillTokens(page.seoTitle || page.title, globals))} description={String(fillTokens(page.description || config.seo?.description, globals))} favicon={config.seo?.favicon} headerCode={config.codeInjection?.headerCode} footerCode={config.codeInjection?.footerCode} noindex={entry.id === 'thank-you'}>
  <Header {config} {navigation} />
  <main id="cubano-demo-content" set:html={renderDemo(template, page, { globals })} />
  <Footer {config} {navigation} />
  <Fragment set:html={scriptsSource} />
  <script type="application/json" id="cubano-tina-preview" set:html={preview} />
  <script>
    if (window.parent !== window) import('../lib/demo-preview').then(({ mountDemoPreview }) => mountDemoPreview());
  </script>
</Base>
