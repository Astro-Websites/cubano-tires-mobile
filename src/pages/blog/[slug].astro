---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import config from '../../content/global/config.json';
import navigation from '../../content/global/navigation.json';
import scriptsSource from '../../fragments/scripts.html?raw';
import { render } from 'astro:content';
import { formatDate, getPosts, initial, pill, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}
const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { Content, headings } = await render(post.entry);
const data = post.data;
const faqs = ((data.faqs || []) as { question?: string; answer?: string }[]).filter((faq) => faq?.question);
const toc = [...headings.filter((heading) => heading.depth === 2), ...(faqs.length ? [{ slug: 'faq', text: 'FAQ' }] : [])];
const category = post.categories[0];
const colors = pill(category?.color);
const safeUrl = (value?: string) => (value && /^(?:\/(?![/\\])|https:\/\/|#|tel:|sms:)/i.test(value.trim()) ? value.trim() : '#');
const related = [
  ...posts.filter((other) => other !== post && other.categories.some((c) => post.categories.some((own) => own.slug === c.slug))),
  ...posts.filter((other) => other !== post),
].filter((other, index, list) => list.indexOf(other) === index).slice(0, 3);
const updated = post.updated || post.date;
const sms = `sms:${config.phoneDigits}`;
const preview = JSON.stringify({ relativePath: post.entry.filePath?.split('/').pop() }).replace(/</g, '\\u003c');
---
<Base title={post.seoTitle} description={post.description || config.seo?.description} favicon={config.seo?.favicon} headerCode={config.codeInjection?.headerCode} footerCode={config.codeInjection?.footerCode}>
  <Header {config} {navigation} />
  <main>
    <section id="top" style="background: #FFFFFF">
      <div style="max-width: 820px; margin: 0 auto; padding: 20px 24px 24px">
        <nav aria-label="Breadcrumb" style="margin: 0 0 32px; font-size: 14px; color: #5B6575"><a href="/" style="color: #5B6575">Home</a> › <a href="/blog/" style="color: #5B6575">Tire Tips</a>{category && <> › <a href={`/blog/category/${category.slug}/`} style="color: #5B6575">{category.title}</a></>}</nav>
        {category && <p style={`margin: 0; display: inline-block; padding: 6px 12px; border-radius: 999px; background: ${colors.bg}; font-size: 13px; font-weight: 800; color: ${colors.fg}; text-transform: uppercase`}>{category.title}</p>}
        <h1 data-blog-field="title" style="font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; font-size: clamp(34px, 4vw, 52px); line-height: 1.08; margin: 16px 0 0; color: #16181D">{post.title}</h1>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 22px; font-size: 14px; color: #5B6575">
          {post.author && <span style="display: flex; align-items: center; gap: 10px">{post.author.avatar ? <img src={post.author.avatar} alt="" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover"/> : <span style="display: inline-flex; width: 44px; height: 44px; border-radius: 50%; background: #FFC72C; align-items: center; justify-content: center; font-weight: 900; font-size: 18px; color: #16181D">{initial(post.author.name)}</span>}<span><strong style="color: #16181D">{post.author.name}</strong>{post.author.role && <><br/>{post.author.role}</>}</span></span>}
          {data.reviewedBy && <span>{data.reviewedBy}</span>}
          <span>{[updated && `${post.updated ? 'Updated' : 'Published'} ${formatDate(updated)}`, post.readTime].filter(Boolean).join(' · ')}</span>
        </div>
      </div>
      <div style="max-width: 1040px; margin: 0 auto; padding: 8px 24px 0">
        <img alt={post.heroImageAlt} src={post.heroImage} style="display: block; width: 100%; aspect-ratio: 16 / 8; object-fit: cover; border-radius: 22px"/>
      </div>
    </section>
    <section style="max-width: 1240px; margin: 0 auto; padding: 48px 24px 72px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start">
      <article style="flex: 999 1 600px; min-width: 0; max-width: 760px; font-size: 18px; line-height: 1.75; color: #2A2F38">
        {data.quickAnswer && (
          <div style="padding: 24px 28px; border-radius: 16px; background: #EEF7EF; border: 1px solid #CDE6D2; margin-bottom: 32px">
            <p style="margin: 0; font-size: 13px; font-weight: 800; letter-spacing: 0.1em; color: #1E7B34">QUICK ANSWER</p>
            <p data-blog-field="quickAnswer" style="margin: 8px 0 0; font-size: 18px; line-height: 1.6; color: #16181D">{data.quickAnswer}</p>
          </div>
        )}
        {toc.length > 1 && (
          <nav aria-label="In this article" style="padding: 20px 24px; border-radius: 14px; background: #F3F6FA; font-size: 16px; margin-bottom: 12px">
            <p style="margin: 0; font-weight: 800; color: #16181D">In this article</p>
            <ol style="margin: 10px 0 0; padding-left: 20px; line-height: 1.9">
              {toc.map((heading) => <li><a href={`#${heading.slug}`} style="color: #1D3E8A">{heading.text}</a></li>)}
            </ol>
          </nav>
        )}
        <div class="cub-article" data-blog-field="body"><Content /></div>
        {faqs.length > 0 && (
          <>
            <h2 id="faq" style="font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; font-size: 30px; line-height: 1.2; margin: 44px 0 0; color: #16181D">FAQ</h2>
            <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 16px">
              {faqs.map((faq) => <details style="padding: 18px 22px; border-radius: 14px; background: #F3F6FA"><summary style="font-weight: 800; font-size: 17px; color: #16181D; cursor: pointer">{faq.question}</summary><p style="margin: 10px 0 0; font-size: 16px; line-height: 1.65; color: #4A5565">{faq.answer}</p></details>)}
            </div>
          </>
        )}
        {post.author && (
          <div style="margin: 44px 0 0; padding: 28px; border-radius: 18px; border: 1px solid #E4E8EE; display: flex; gap: 20px; align-items: flex-start">
            {post.author.avatar ? <img src={post.author.avatar} alt="" style="flex: none; width: 72px; height: 72px; border-radius: 50%; object-fit: cover"/> : <span style="flex: none; display: inline-flex; width: 72px; height: 72px; border-radius: 50%; background: #FFC72C; align-items: center; justify-content: center; font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; font-size: 28px; color: #16181D">{initial(post.author.name)}</span>}
            <span style="display: flex; flex-direction: column; gap: 6px"><span style="font-weight: 900; font-size: 19px; color: #16181D">{post.author.name}</span>{post.author.bio && <span style="font-size: 15px; line-height: 1.6; color: #5B6575">{post.author.bio}</span>}</span>
          </div>
        )}
      </article>
      <aside style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 20px; position: sticky; top: 120px">
        <div style="padding: 28px; border-radius: 20px; background: #FFC72C">
          <p style="margin: 0; font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; font-size: 22px; line-height: 1.2; color: #16181D">Flat tire? We come to you.</p>
          <p style="margin: 10px 0 0; font-size: 15px; line-height: 1.6; color: #2A2F38">Text a photo for a price and an arrival time. The price we quote is the price you pay.</p>
          <a href={sms} style="margin-top: 16px; display: flex; align-items: center; justify-content: center; min-height: 52px; border-radius: 999px; background: #16181D; font-weight: 800; color: #FFFFFF">Text Us a Photo</a>
          <a href={`tel:${config.phoneDigits}`} style="margin-top: 10px; display: flex; align-items: center; justify-content: center; min-height: 48px; border-radius: 999px; background: #FFFFFF; font-weight: 800">Call {config.phoneDisplay}</a>
        </div>
        {data.relatedService?.label && (
          <div style="padding: 24px; border-radius: 20px; border: 1px solid #E4E8EE">
            <p style="margin: 0; font-weight: 800; color: #16181D">Related service</p>
            <a href={safeUrl(data.relatedService.url)} style="margin-top: 12px; display: flex; justify-content: space-between; font-weight: 700; color: #E11B22">{data.relatedService.label} <span aria-hidden="true">→</span></a>
          </div>
        )}
      </aside>
    </section>
    {related.length > 0 && (
      <section style="background: #F3F6FA">
        <div style="max-width: 1240px; margin: 0 auto; padding: 64px 24px">
          <h2 style="font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; font-size: 30px; margin: 0; color: #16181D">Keep reading</h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 20px; margin-top: 24px">
            {related.map((other) => <BlogCard post={other} />)}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer {config} {navigation} />
  <Fragment set:html={scriptsSource} />
  <script type="application/json" id="cubano-blog-preview" set:html={preview} />
  <script>
    if (window.parent !== window) import('../../lib/blog-preview').then(({ mountBlogPreview }) => mountBlogPreview());
  </script>
</Base>
<style is:global>
  .cub-article h2 { font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; font-size: 30px; line-height: 1.2; margin: 44px 0 0; color: #16181D; }
  .cub-article h3 { font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 800; font-size: 23px; line-height: 1.25; margin: 32px 0 0; color: #16181D; }
  .cub-article p { margin: 14px 0 0; }
  .cub-article ul, .cub-article ol { margin: 14px 0 0; padding-left: 22px; }
  .cub-article ul { list-style: disc; }
  .cub-article ol { list-style: decimal; }
  .cub-article li + li { margin-top: 4px; }
  .cub-article a { color: #1D3E8A; text-decoration: underline; }
  .cub-article strong { color: #16181D; }
  .cub-article img { display: block; max-width: 100%; height: auto; border-radius: 18px; margin: 32px 0 0; }
  .cub-article blockquote { margin: 32px 0 0; padding: 4px 0 4px 24px; border-left: 4px solid #FFC72C; }
  .cub-article blockquote p:first-child { margin: 0; font-size: 20px; line-height: 1.6; font-weight: 600; color: #16181D; }
  .cub-article blockquote p + p { margin-top: 8px; font-size: 14px; font-weight: 700; color: #5B6575; }
  .cub-article > :first-child { margin-top: 32px; }
</style>
