---
import DesignedPage from '../components/DesignedPage.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('page'))
    .filter(({ id, data }) => Boolean(data.demoTemplate) && id !== 'homepage')
    .map((entry) => ({ params: { demo: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<DesignedPage {entry} />
