---
// The homepage is a designed page like the others: its design is
// src/fragments/demo-pages/homepage.html and its text and images live in
// src/content/page/homepage.md (Tina: Pages > homepage).
import DesignedPage from '../components/DesignedPage.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('page', 'homepage');
if (!entry) throw new Error('Required Tina Pages document src/content/page/homepage.md is missing.');
---
<DesignedPage {entry} />
