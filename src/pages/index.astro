---
import Header from '../components/Header.astro';
import HomePage from '../components/HomePage.astro';
import Footer from '../components/Footer.astro';
import Base from '../layouts/Base.astro';
import config from '../content/global/config.json';
import navigation from '../content/global/navigation.json';
import scriptsSource from '../fragments/scripts.html?raw';
---
<Base
  title="Cubano Tires Mobile Shop | Mobile Tire Service in Orange County & LA"
  description="Mobile tire and fleet service in Orange County and Los Angeles."
>
  <Header {config} {navigation} />
  <main><HomePage /></main>
  <Footer {config} {navigation} />
  <Fragment set:html={scriptsSource} />
</Base>
