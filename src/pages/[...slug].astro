---
// Every page except the homepage and the blog. Tina: Pages (designed and simple pages) plus the
// folder collections Areas, Services, Tires, Vehicles and Gallery (src/lib/page-collections.ts).
import DesignedPage from '../components/DesignedPage.astro';
import SimplePage from '../components/SimplePage.astro';
import { getCollection } from 'astro:content';
import { SECTION_COLLECTIONS, sectionSlug, type SectionCollection } from '../lib/page-collections';
export async function getStaticPaths() {
  const pages = (await getCollection('page'))
    .filter(({ id }) => id !== 'homepage')
    .map((entry) => entry.data._template === 'simple' || !entry.data.demoTemplate
      ? { params: { slug: entry.id }, props: { entry, kind: 'simple' as const } }
      : { params: { slug: entry.id }, props: { entry, kind: 'designed' as const } });
  const folders = await Promise.all((Object.keys(SECTION_COLLECTIONS) as SectionCollection[]).map(async (name) =>
    (await getCollection(name))
      .filter(({ data }) => Boolean(data.demoTemplate))
      .map((entry) => ({ params: { slug: sectionSlug(name, entry.id) }, props: { entry, kind: 'designed' as const } }))));
  const all = [...pages, ...folders.flat()];
  const reserved = new Set(['tire-tips', 'admin', 'uploads']);
  const seen = new Set<string>();
  for (const { params, props } of all) {
    if (seen.has(params.slug) || reserved.has(params.slug.split('/')[0]))
      throw new Error(`"${props.entry.filePath}" uses the URL /${params.slug}/, which already exists. Rename the file.`);
    seen.add(params.slug);
  }
  return all;
}
const { entry, kind } = Astro.props;
---
{kind === 'designed' ? <DesignedPage {entry} /> : <SimplePage {entry} />}
