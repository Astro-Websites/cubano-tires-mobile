---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Base from '../../layouts/Base.astro';
import config from '../../content/global/config.json';
import navigation from '../../content/global/navigation.json';
import scriptsSource from '../../fragments/scripts.html?raw';

const phoneDisplay = (config as any).phoneDisplay || '(888) 333-3173';
const phoneDigits = (config as any).phoneDigits || '8883333173';
const heading = "font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; color: #16181D";
---
<Base
  title="Shop Tires Online | Cubano Tires Mobile Shop"
  description="Search tires by vehicle or size, see installed prices and book mobile installation anywhere in Orange County with Cubano Tires Mobile Shop."
  favicon={config.seo?.favicon}
  headerCode={config.codeInjection?.headerCode}
  footerCode={config.codeInjection?.footerCode}
>
  <Header {config} {navigation} />
  <main>
    <section style="background: #FFC72C">
      <div style="max-width: 1240px; margin: 0 auto; padding: 32px 24px 56px">
        <nav aria-label="Breadcrumb" style="font-size: 14px; color: #3A4555"><a href="/" style="color: #3A4555">Home</a> › <span style="color: #16181D; font-weight: 700">Shop Tires</span></nav>
        <h1 style={`${heading}; font-size: clamp(32px, 4.4vw, 56px); line-height: 1.05; margin: 16px 0 0`}>Shop Tires Online</h1>
        <p style="max-width: 720px; margin: 14px 0 0; font-size: 18px; line-height: 1.6; color: #1B2430">Search by vehicle or tire size, compare brands and installed prices, then pick a time. We bring the tires to your driveway, office or job site and install them on the spot.</p>
        <div id="shop" style="margin-top: 28px; max-width: 100%; min-width: 0; border-radius: 20px; background: #FFFFFF; border: 1px solid #E4E8EE; box-shadow: 0 30px 60px rgba(22,24,29,0.25); overflow: hidden">
          <div style="padding: 16px; display: flex; flex-direction: column; gap: 12px">
            <!-- TIRESanytime search widget -->
            <div id="ta-widget-container" class="tasite-bootstrap-styles" data-dealer="7878a0ae-196f-4b69-99e4-2d3cfcf41aec" data-hostUrl="https://ta3.tiresanytime.com" data-parentUsesBootstrapCss="false" style="min-height: 260px"></div>
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 4px; padding: 14px 16px; border-radius: 12px; background: #FFF1F0; border: 1px dashed #E11B22">
              <span style="font-family: Montserrat, Inter, system-ui, sans-serif; font-weight: 900; font-size: 15px; line-height: 1.25; color: #E11B22">$75 MOBILE FEE WAIVED</span>
              <span style="font-size: 13px; line-height: 1.4; color: #3A4555">with 4 new tires · Orange County only</span>
            </div>
            <p style="margin: 0; font-size: 14px; color: #5B6575; text-align: center">Can't find your tire? <a href={`sms:${phoneDigits}`} style="font-weight: 700; color: #E11B22">Text or call {phoneDisplay}</a></p>
          </div>
        </div>
      </div>
    </section>
    <section aria-label="Commercial and fleet tires">
      <div style="max-width: 1240px; margin: 0 auto; padding: 48px 24px; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between">
        <div style="flex: 1 1 420px; min-width: 0">
          <h2 style={`${heading}; font-size: clamp(24px, 2.6vw, 34px); line-height: 1.15; margin: 0`}>Need commercial or fleet tires?</h2>
          <p style="margin: 10px 0 0; font-size: 16px; line-height: 1.6; color: #3A4555">We stock and install commercial truck, trailer and heavy equipment tires. Tell us the size and quantity and we'll quote it the same day.</p>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 12px">
          <a href="/services/commercial-truck-tires/" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 999px; background: #16181D; color: #FFFFFF; font-weight: 700; text-decoration: none">Commercial truck tires</a>
          <a href="/services/fleet-tire-service/" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 999px; border: 2px solid #16181D; color: #16181D; font-weight: 700; text-decoration: none">Fleet tire service</a>
        </div>
      </div>
    </section>
  </main>
  <Footer {config} {navigation} />
  <Fragment set:html={scriptsSource} />
</Base>
