---
import '../styles/global.css';
import config from '../content/global/config.json';

interface Props {
  title: string;
  description: string;
  favicon?: string;
  headerCode?: string;
  footerCode?: string;
}

const { title, description, favicon, headerCode, footerCode } = Astro.props;
// Staging (staging.*) is never indexed; the canonical follows `site` in astro.config.mjs.
const noindex = !Astro.site || Astro.site.hostname.startsWith('staging.');
const iconType = (href: string) => (/\.svg$/i.test(href) ? 'image/svg+xml' : /\.png$/i.test(href) ? 'image/png' : undefined);
const icon = favicon || config.seo?.favicon || '/favicon.svg';
const appleIcon = (config.seo as { appleTouchIcon?: string } | undefined)?.appleTouchIcon || '/apple-touch-icon.png';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {icon === '/favicon.svg' && <link rel="icon" href="/favicon.ico" sizes="48x48" />}
    <link rel="icon" href={icon} type={iconType(icon)} />
    <link rel="apple-touch-icon" href={appleIcon} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1D3E8A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" />
    <title>{title}</title>
    {headerCode && <Fragment set:html={headerCode} />}
  </head>
  <body>
    <div style="background: #FFFFFF; color: #1B2430; font-family: Inter, system-ui, sans-serif; width: 100%; min-height: 100vh; overflow-x: clip">
      <slot />
      {footerCode && <Fragment set:html={footerCode} />}
    </div>
  </body>
</html>
