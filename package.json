{
  "name": "cubano-tires-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "extract:demo": "node scripts/extract-demo.mjs",
    "dev": "astro dev",
    "cms:build": "tinacms build --content=local --skip-cloud-checks --skip-indexing --skip-search-index --noTelemetry",
    "check": "astro check",
    "build:site": "astro build",
    "build": "npm run build:full",
    "build:full": "npm run validate:authority && npm run cms:build && npm run check && npm run build:site",
    "preview": "astro preview",
    "validate:authority": "node scripts/validate-authority.mjs",
    "validate:local": "node scripts/validate-local.mjs",
    "test": "npm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^7.4.13",
    "tinacms": "^3.15.2",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tinacms/cli": "^4.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
